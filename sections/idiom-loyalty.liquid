      "min": 20,
      "max": 220,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "cloud_top_mobile",
      "label": "Cloud vertical position — mobile",
      "min": -30,
      "max": 120,
      "step": 2,
      "unit": "%",
      "default": -6
