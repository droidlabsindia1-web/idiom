{%- comment -%} /sections/section-locations.liquid {%- endcomment -%}

<div data-section-id="{{ section.id }}" data-section-type="locations">
  {%- render 'locations' -%}
</div>

{% comment %} Schema {% endcomment %}
{% schema %}
{
  "name": "Locations",
  "class": "locations-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our stores"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Locations & hours"
    },
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "range",
      "id": "map_zoom",
      "label": "Map zoom",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Map height",
      "min": 160,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "text",
      "id": "maps_api_key",
      "label": "Google Maps API key (optional)",
      "info": "Adds an interactive, draggable map with brand styling. Restrict the key to your store domains (HTTP referrers) in Google Cloud. Without a key a static map preview is shown."
    },
    {
      "type": "select",
      "id": "map_style",
      "label": "Map style (needs API key)",
      "options": [
        { "value": "muted", "label": "Muted / brand" },
        { "value": "standard", "label": "Standard Google" }
      ],
      "default": "muted"
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Popup directions button label",
      "info": "Leave empty to hide.",
      "default": "Get directions"
    },
    {
      "type": "text",
      "id": "book_label",
      "label": "Popup \"book a visit\" link label",
      "info": "Shown when a booking link is set.",
      "default": "Book a visit"
    },
    {
      "type": "text",
      "id": "maps_label",
      "label": "Popup Google Maps button label",
      "info": "Leave empty to hide.",
      "default": "View in Google Maps"
    },
    {
      "type": "checkbox",
      "id": "show_distance",
      "label": "Show distance from visitor in popup",
      "info": "Asks the visitor for their location when they open the popup. Needs latitude / longitude.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "gradient",
      "label": "Overlay gradient"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "name": "Locations",
      "type": "locations",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Address",
          "default": "566 Emerson Street Palo Alto, California"
        },
        {
          "type": "richtext",
          "id": "working_time",
          "label": "Hours",
          "default": "<p>Mon - Fri: 8am - 5pm<\/p><p>Sat: Closed<\/p><p>Sun: Closed<\/p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Store image"
        },
        {
          "type": "header",
          "content": "Map"
        },
        {
          "type": "checkbox",
          "id": "show_map",
          "label": "Show map",
          "default": true
        },
        {
          "type": "text",
          "id": "latitude",
          "label": "Latitude",
          "info": "Most accurate pin placement. In Google Maps, right-click the store and copy the coordinates. Falls back to the address if empty."
        },
        {
          "type": "text",
          "id": "longitude",
          "label": "Longitude"
        },
        {
          "type": "header",
          "content": "Store details popup"
        },
        {
          "type": "text",
          "id": "store_name",
          "label": "Store name",
          "info": "Defaults to the section heading."
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "richtext",
          "id": "modal_note",
          "label": "Extra note",
          "info": "E.g. nearest tube station, accessibility info."
        },
        {
          "type": "url",
          "id": "book_url",
          "label": "Book a visit link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Locations",
      "blocks": [
        {
          "type": "locations"
        },
        {
          "type": "locations"
        },
        {
          "type": "locations"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
