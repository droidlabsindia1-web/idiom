{%- comment -%}
  idiom — Store Locator
  Split layout: left = eyebrow / heading / address / hours + Google map with red pin,
  right = image, GIF or video. Clicking the pin opens a store-details modal.

  Map modes:
  - Google Maps API key set + latitude/longitude → interactive JS map with a custom red marker.
  - No key → keyless Google Maps embed (static preview) with a red pin button on top.
{%- endcomment -%}

{{ 'idiom-store-locator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'idiom-store-locator.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign store_name = s.store_name | default: s.heading
  assign lat = s.latitude | strip
  assign lng = s.longitude | strip

  if lat != blank and lng != blank
    assign map_query = lat | append: ',' | append: lng
  else
    assign map_query = s.address | url_encode
  endif

  assign api_key = s.maps_api_key | strip
  assign directions_url = 'https://www.google.com/maps/dir/?api=1&destination=' | append: map_query
  assign has_map = false
  if map_query != blank
    assign has_map = true
  endif

  assign media_class = ''
  if s.media_position == 'left'
    assign media_class = ' idiom-store-locator--media-left'
  endif
-%}

<idiom-store-locator
  class="idiom-store-locator{{ media_class }}"
  style="
    --isl-bg: {{ s.bg_color }};
    --isl-text: {{ s.text_color }};
    --isl-pt: {{ s.padding_top }}px;
    --isl-pb: {{ s.padding_bottom }}px;
    --isl-map-h: {{ s.map_height }}px;
    --isl-media-ratio: {{ s.media_ratio }};
    --isl-media-radius: {{ s.media_radius }}px;
  "
>
  <div class="idiom-store-locator__inner">
    {%- comment -%} Left: content + map {%- endcomment -%}
    <div class="idiom-store-locator__content">
      {%- if s.eyebrow != blank -%}
        <p class="idiom-store-locator__eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="idiom-store-locator__heading">{{ s.heading }}</h2>
      {%- endif -%}

      {%- if s.address != blank -%}
        <address class="idiom-store-locator__address">{{ s.address }}</address>
      {%- endif -%}

      {%- if s.hours != blank -%}
        <div class="idiom-store-locator__hours">{{ s.hours }}</div>
      {%- endif -%}

      {%- if s.description != blank -%}
        <div class="idiom-store-locator__desc">{{ s.description }}</div>
      {%- endif -%}

      {%- if s.show_map -%}
        <div
          class="idiom-store-locator__map"
          data-map
          data-lat="{{ lat | escape }}"
          data-lng="{{ lng | escape }}"
          data-zoom="{{ s.map_zoom }}"
          data-style="{{ s.map_style }}"
          data-title="{{ store_name | escape }}"
          {% if api_key != blank %}data-api-key="{{ api_key | escape }}"{% endif %}
        >
          {%- if has_map -%}
            <iframe
              data-map-fallback
              src="https://maps.google.com/maps?q={{ map_query }}&z={{ s.map_zoom }}&output=embed"
              title="{{ 'Map showing' | append: ' ' | append: store_name | escape }}"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              tabindex="-1"
              style="pointer-events: none;"
            ></iframe>
            <button
              type="button"
              class="idiom-store-locator__pin"
              data-map-fallback
              data-open-store-modal
              aria-haspopup="dialog"
              aria-label="{{ 'View store details for' | append: ' ' | append: store_name | escape }}"
            >
              <svg viewBox="0 0 40 52" aria-hidden="true" focusable="false">
                <path d="M20 0C9 0 0 8.9 0 19.9 0 34.8 20 52 20 52s20-17.2 20-32.1C40 8.9 31 0 20 0z" fill="#E53935"/>
                <circle cx="20" cy="19" r="7" fill="#fff"/>
              </svg>
            </button>
          {%- else -%}
            <div class="idiom-store-locator__map-placeholder">
              Add the store address or latitude / longitude in the section settings to show the map.
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Right: image / GIF / video {%- endcomment -%}
    <div class="idiom-store-locator__media">
      {%- if s.media_type == 'video' and s.video != blank -%}
        {{
          s.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            preload: 'metadata',
            image_size: '1400x'
        }}
      {%- elsif s.media_type == 'video_url' and s.video_url != blank -%}
        {%- if s.video_url.type == 'youtube' -%}
          <iframe
            src="https://www.youtube-nocookie.com/embed/{{ s.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ s.video_url.id }}&controls=0&playsinline=1&rel=0"
            title="{{ store_name | escape }}"
            allow="autoplay; encrypted-media; picture-in-picture"
            loading="lazy"
          ></iframe>
        {%- elsif s.video_url.type == 'vimeo' -%}
          <iframe
            src="https://player.vimeo.com/video/{{ s.video_url.id }}?background=1&autoplay=1&loop=1&muted=1"
            title="{{ store_name | escape }}"
            allow="autoplay; fullscreen; picture-in-picture"
            loading="lazy"
          ></iframe>
        {%- endif -%}
      {%- elsif s.image != blank -%}
        {%- assign alt = s.image.alt | default: store_name -%}
        {%- if s.image.src contains '.gif' -%}
          {%- comment -%} Single source keeps GIF animation intact {%- endcomment -%}
          <img
            src="{{ s.image | image_url: width: 1600 }}"
            alt="{{ alt | escape }}"
            width="{{ s.image.width }}"
            height="{{ s.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{
            s.image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              alt: alt,
              widths: '480, 720, 960, 1200, 1500, 1800',
              sizes: '(max-width: 768px) 100vw, 50vw'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Store details modal {%- endcomment -%}
  <dialog class="idiom-store-modal" aria-labelledby="StoreModalTitle-{{ section.id }}">
    <button type="button" class="idiom-store-modal__close" data-modal-close aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>

    {%- if s.modal_image != blank -%}
      {{
        s.modal_image
        | image_url: width: 840
        | image_tag: class: 'idiom-store-modal__image', loading: 'lazy', alt: store_name
      }}
    {%- endif -%}

    <div class="idiom-store-modal__body">
      <h3 class="idiom-store-modal__title" id="StoreModalTitle-{{ section.id }}">{{ store_name }}</h3>

      <ul class="idiom-store-modal__list">
        {%- if s.address != blank -%}
          <li class="idiom-store-modal__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <path d="M12 21s-7-6.2-7-11.5a7 7 0 1114 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
            </svg>
            <span>{{ s.address }}</span>
          </li>
        {%- endif -%}

        {%- if s.hours != blank -%}
          <li class="idiom-store-modal__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
            </svg>
            <div>{{ s.hours }}</div>
          </li>
        {%- endif -%}

        {%- if s.phone != blank -%}
          <li class="idiom-store-modal__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/>
            </svg>
            <a href="tel:{{ s.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ s.phone }}</a>
          </li>
        {%- endif -%}

        {%- if s.email != blank -%}
          <li class="idiom-store-modal__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
            </svg>
            <a href="mailto:{{ s.email }}">{{ s.email }}</a>
          </li>
        {%- endif -%}

        {%- if s.modal_note != blank -%}
          <li class="idiom-store-modal__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
            </svg>
            <div>{{ s.modal_note }}</div>
          </li>
        {%- endif -%}
      </ul>

      {%- if s.directions_label != blank and has_map -%}
        <a class="idiom-store-modal__cta" href="{{ directions_url }}" target="_blank" rel="noopener">
          {{ s.directions_label }}
        </a>
      {%- endif -%}
    </div>
  </dialog>
</idiom-store-locator>

{% schema %}
{
  "name": "Store locator",
  "tag": "section",
  "class": "idiom-store-locator-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Get your layer on, IRL..."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Idiom | Soho, London"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "12 Ingestre Place, Soho, London W1F 0JF"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "Opening hours",
      "info": "One line per paragraph.",
      "default": "<p>Monday - Friday | 12.00 - 19.00</p><p>Saturday | 11.00 - 19.00</p><p>Sunday | 12.00 - 17.00</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description (optional)"
    },
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "label": "Show map",
      "default": true
    },
    {
      "type": "text",
      "id": "latitude",
      "label": "Latitude",
      "info": "Most accurate pin placement. In Google Maps, right-click the store and copy the coordinates. Falls back to the address if empty.",
      "default": "51.5135"
    },
    {
      "type": "text",
      "id": "longitude",
      "label": "Longitude",
      "default": "-0.1365"
    },
    {
      "type": "range",
      "id": "map_zoom",
      "label": "Zoom",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Map height",
      "min": 160,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "text",
      "id": "maps_api_key",
      "label": "Google Maps API key (optional)",
      "info": "Adds an interactive, draggable map with styling. Restrict the key to your store domains (HTTP referrers) in Google Cloud. Without a key a static map preview is shown."
    },
    {
      "type": "select",
      "id": "map_style",
      "label": "Map style (needs API key)",
      "options": [
        { "value": "muted", "label": "Muted / brand" },
        { "value": "standard", "label": "Standard Google" }
      ],
      "default": "muted"
    },
    {
      "type": "header",
      "content": "Store details popup"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store name",
      "info": "Defaults to the heading."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "richtext",
      "id": "modal_note",
      "label": "Extra note",
      "info": "E.g. nearest tube station, accessibility info."
    },
    {
      "type": "image_picker",
      "id": "modal_image",
      "label": "Popup image"
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Directions button label",
      "info": "Leave empty to hide.",
      "default": "Get directions"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image / GIF" },
        { "value": "video", "label": "Video (uploaded)" },
        { "value": "video_url", "label": "Video (YouTube / Vimeo)" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image or GIF"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted on loop."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube / Vimeo URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Media shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Media corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Colors & spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#fffbf3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Store locator"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
