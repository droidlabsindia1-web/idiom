{%- comment -%} /sections/banner-image.liquid — idiom redesign {%- endcomment -%}

{{ 'section-banner-image.css' | asset_url | stylesheet_tag }}
{{ 'idiom-theme.css' | asset_url | stylesheet_tag }}

<style>
  /* === idiom Hero — section-banner-image === */
  #SectionBannerImage--{{ section.id }} .idiom-hero {
    position: relative;
    width: 100%;
    /* Fill the screen below the header, leaving ~64px so the green section's
       top scroller line peeks above the fold. */
    min-height: calc(
      100vh - var(--header-height, 109px) - var(--announcement-height, 31px) - 64px
    );
    overflow: hidden;
    background: #fffbf3;
    padding: 0 16px;
    border-radius: 43px;
    overflow: hidden;
  }

  #SectionBannerImage--{{ section.id }} .idiom-hero__bg--placeholder {
    position: absolute;
    inset: 0;
    background: #fffbf3;
  }

  #SectionBannerImage--{{ section.id }} .idiom-hero__bg {
    position: absolute;
    inset: 0;
    width: calc(100% - 32px);
    height: 100%;
    object-fit: cover;
    object-position: center;
    margin: 0 16px;
    border-radius: 43px;
    overflow: hidden;
  }

  #SectionBannerImage--{{ section.id }} .idiom-hero__overlay {
    display: none;
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, #202020 100%);
    pointer-events: none;
    width: calc(100% - 32px);
    height: 100%;
    margin: 0 16px;
    border-radius: 43px;
  }

  #SectionBannerImage--{{ section.id }} .idiom-hero__content {
    position: absolute;
    bottom: 48px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: 100%;
    max-width: 780px;
    text-align: center;
    padding: 0 24px;
  }

  #SectionBannerImage--{{ section.id }} .idiom-hero__heading {
    font-size: 56px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    margin: 0 0 4px;
    letter-spacing: -0.01em;
  }

  #SectionBannerImage--{{ section.id }} .idiom-hero__subtext {
    font-size: 15px;
    color: #ffffff;
    margin: 0 0 16px;
    line-height: 1.5;
    opacity: 0.9;
  }

  /* CTA wrapper spacing */
  #SectionBannerImage--{{ section.id }} .idiom-hero__content .idiom-hero__cta-wrap {
    display: block;
  }

  /* Watermark text */
  #SectionBannerImage--{{ section.id }} .idiom-hero__watermark {
    position: absolute;
    right: -20px;
    bottom: 20px;
    z-index: 1;
    font-size: 96px;
    font-weight: 900;
    color: rgba(255,255,255,0.12);
    line-height: 1;
    white-space: nowrap;
    letter-spacing: -0.02em;
    pointer-events: none;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
  }


  /* === Mobile overrides ≤480px === */
  @media (max-width: 480px) {
    #SectionBannerImage--{{ section.id }} .idiom-hero__bg { 
      border-radius: 12px;
    }
    #SectionBannerImage--{{ section.id }} .idiom-hero {
      /* Fill the screen below the header, leaving ~52px so the green section's
         top scroller line peeks above the fold. */
      min-height: calc(
        100vh - var(--header-height, 64px) - var(--announcement-height, 0px) - 52px
      );
      border-radius: 12px;
      margin-top: 12px;
    }

    #SectionBannerImage--{{ section.id }} .idiom-hero__content {
      bottom: 12px;
      max-width: 100%;
    }

    #SectionBannerImage--{{ section.id }} .idiom-hero__heading {
      font-size: 28px;
    }

    #SectionBannerImage--{{ section.id }} .idiom-hero__subtext {
      font-size: 12px;
      margin-bottom: 12px;
    }

    #SectionBannerImage--{{ section.id }} .idiom-hero__content .idiom-hero__cta-wrap {
      width: 100%;
    }

    #SectionBannerImage--{{ section.id }} .idiom-hero__watermark {
      display: none;
    }
  }
</style>


<section
  id="SectionBannerImage--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="banner-image"
>

  <div class="idiom-hero">
    {%- if section.settings.image != blank -%}
      <img class="idiom-hero__bg"
        src="{{ section.settings.image | image_url: width: 2400 }}"
        alt="{{ section.settings.heading | escape }}"
        loading="eager" fetchpriority="high">
    {%- elsif section.settings.hero_image != blank -%}
      <img class="idiom-hero__bg"
        src="{{ section.settings.hero_image | image_url: width: 2400 }}"
        alt="{{ section.settings.heading | escape }}"
        loading="eager" fetchpriority="high">
    {%- else -%}
      <div class="idiom-hero__bg idiom-hero__bg--placeholder"></div>
    {%- endif -%}
    <div class="idiom-hero__overlay"></div>
    <div class="idiom-hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="idiom-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="idiom-hero__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <div class="idiom-hero__cta-wrap">
          {%- render 'idiom-cta-button', label: section.settings.cta_label, href: section.settings.cta_url -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>


