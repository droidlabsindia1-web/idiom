{%- comment -%}
  Duplicate of section-columns.liquid, powered by product metafields instead of blocks.
  For each index N (1..max_items) it reads:
    - {namespace}.pdp_note_image_N           (file reference: image)
    - {namespace}.pdp_ingredient_name_N      (single line text)
    - {namespace}.pdp_ingredient_description_N (rich text / multi-line text)
  Indexes with neither an image nor a name are skipped. The section hides itself when no items are found.
{%- endcomment -%}

{%- liquid
  assign unique = section.id
  assign bg_color = section.settings.bg_color
  assign gradient = section.settings.gradient | default: 'none'
  assign section_width = section.settings.width
  assign equalize_height = section.settings.equalize_height
  assign columns = section.settings.columns
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign layout_mobile = section.settings.layout_mobile
  assign heading_size = section.settings.heading_size | times: 0.01
  assign item_heading_size = section.settings.item_heading_size | times: 0.01
  assign item_text_size = section.settings.item_text_size | times: 0.01
  assign show_images = section.settings.show_images
  assign show_borders = section.settings.show_borders
  assign desktop_aspect_ratio = section.settings.desktop_aspect_ratio | times: 100
  assign mobile_aspect_ratio = section.settings.mobile_aspect_ratio | times: 100
  assign color_borders = section.settings.color_borders
  assign namespace = section.settings.metafield_namespace | default: 'custom' | strip
  assign max_items = section.settings.max_items
  assign id = 'SectionColumns--' | append: section.id
  assign selector_id = '#' | append: id
  assign animation_anchor = selector_id
  assign animations_enabled = settings.animations_enabled
  assign animation_delay = 150

  assign source_product = product
  if source_product == blank and section.settings.product != blank
    assign source_product = section.settings.product
  endif

  comment
    First pass: collect the indexes that actually have content
  endcomment
  assign item_indexes = ''
  if source_product != blank
    assign mf = source_product.metafields[namespace]
    for i in (1..max_items)
      assign image_key = 'pdp_note_image_' | append: i
      assign name_key = 'pdp_ingredient_name_' | append: i
      if mf[image_key] != blank or mf[name_key] != blank
        assign item_indexes = item_indexes | append: i | append: ','
      endif
    endfor
  endif
  assign item_indexes = item_indexes | split: ','
  assign items_count = item_indexes.size

  case layout_mobile
    when 'grid'
      assign mobile_width = 'mobile--one-half'
      assign mobile_class = ' grid--mobile'
    when 'stacked'
      assign mobile_width = 'mobile--one-whole'
      assign mobile_class = ' stacked--mobile'
    when 'carousel'
      assign mobile_class = ' carousel--mobile'

      case columns_mobile
        when 1
          assign mobile_width = 'mobile--one-whole'
        when 2
          assign mobile_width = 'mobile--one-half'
      endcase
  endcase

  case columns
    when 2
      assign item_width = 'one-half'
    when 3
      assign item_width = 'one-third'
    else
      assign item_width = 'one-quarter'
  endcase

  assign bg_color_set = false
  if gradient != 'none' or bg_color.alpha != 0.0 and bg_color != ''
    assign bg_color_set = true
  endif

  comment
    Images sizes
  endcomment
  assign blocks_gaps = columns | minus: 1
  assign gaps_calc = 20 | times: blocks_gaps | append: 'px'

  if section_width == 'wrapper--full-padded'
    assign wrapper_width_lg = '(100vw - 120px)'
  endif
  if section_width == 'wrapper'
    assign wrapper_width_lg = '(1440px - 120px)'
  endif
  assign img_width_lg = 'calc((' | append: wrapper_width_lg | append: ' - ' | append: gaps_calc | append: ') / ' | append: columns | append: ')'

  assign wrapper_width_md = '(100vw - 2 * 20px)'
  assign img_width_md = 'calc((' | append: wrapper_width_md | append: ' * 0.9 - 20px) / 2)'

  assign img_width_sm = 'calc(' | append: wrapper_width_md | append: ')'
  if items_count > 1
    assign img_width_sm = 'calc(' | append: wrapper_width_md | append: ' - 20px)'
  endif

  assign sizes = '(min-width: 1024px) ' | append: img_width_lg | append: ', (min-width: 768px) ' | append: img_width_md | append: ', ' | append: img_width_sm
-%}

{%- if items_count > 0 or request.design_mode -%}
  {{ 'section-columns.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    {{ selector_id }} {
      --PT: {{ section.settings.padding_top }}px;
      --PB: {{ section.settings.padding_bottom }}px;

      {% if color_borders != 'rgba(0,0,0,0)' and color_borders != '' -%}
        --border: {{ color_borders }};
      {%- endif %}

      {% unless columns == 3 -%}
        --grid-tablet: repeat(2, minmax(0, 1fr));
      {%- endunless %}

      {% if bg_color_set -%}
        {%- if gradient != 'none' -%}
          --bg: {{ gradient }};
        {%- else -%}
          --bg: {{ bg_color }};
        {%- endif -%}
      {%- endif %}
    }

    {{ selector_id }} .section__heading { --adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ heading_size }}); }
    {{ selector_id }} .column-item__heading { --adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ item_heading_size }}); }
    {{ selector_id }} .column-item__text p { --adjust-body: calc(var(--FONT-ADJUST-BODY) * {{ item_text_size }}); }
    {{ selector_id }} .column-item__image-wrapper { --aspect-ratio: {{ desktop_aspect_ratio }}%; }

    {% if equalize_height -%}
      @media screen and (max-width: 767px) {
        {{ selector_id }} .column-item__image-wrapper { --aspect-ratio: {{ mobile_aspect_ratio }}%; }
      }
    {%- endif %}

    {% if columns_mobile > 1 -%}
      @media screen and (max-width: 767px) {
        {{ selector_id }} .carousel--mobile { --item-width-mobile: calc(90% / {{ columns_mobile }} - var(--grid-gutter)); }
      }
    {%- endif %}
  {%- endstyle -%}

  <div
    id="{{ id }}"
    class="section-padding section-columns {{ section.settings.align_text }}"
    data-section-id="{{ unique }}"
    data-section-type="columns-with-image"
  >
    <div class="{{ section_width }}">
      {%- if section.settings.title != '' -%}
        <div class="section__header">
          <h2
            class="section__heading h2"
            data-aos="fade-up"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-delay="{{ animation_delay }}"
            {%- assign animation_delay = animation_delay | plus: 150 -%}
          >
            {{ section.settings.title }}
          </h2>

          {%- if settings.show_spacer_lines -%}
            <hr
              class="section__heading-line"
              {% if animations_enabled %}
                data-aos="fade-up"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-delay="{{ animation_delay }}"
                {%- assign animation_delay = animation_delay | plus: 150 -%}
              {% endif %}
            >
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="section-columns__wrapper carousel__container">
        {%- if items_count > 0 -%}
          <div class="section-columns__slider carousel{{ mobile_class }}" data-slider role="group">
            {%- for index in item_indexes -%}
              {%- liquid
                assign image_key = 'pdp_note_image_' | append: index
                assign name_key = 'pdp_ingredient_name_' | append: index
                assign description_key = 'pdp_ingredient_description_' | append: index

                assign title = mf[name_key].value
                assign text = mf[description_key] | metafield_tag
                assign image = mf[image_key].value
                if image.preview_image != blank
                  assign image = image.preview_image
                endif
                assign item_id = section.id | append: '-' | append: index

                assign item_aspect_ratio = desktop_aspect_ratio
                if equalize_height == false
                  assign item_aspect_ratio = 0.67 | times: 100
                endif

                if image != blank
                  assign image_alt = image.alt | default: title | strip_html | escape

                  if equalize_height == false
                    assign item_aspect_ratio = 1 | divided_by: image.aspect_ratio | times: 100
                  endif
                endif
              -%}

              <div id="columnItem--{{ item_id }}"
                class="column-item carousel__item {{ item_width }} {{ mobile_width }}{% if show_borders %} column-item--border{% endif %}{% if show_images %} column-item--image{% endif %}"
                data-slider-item
                {% if animations_enabled %}
                  data-aos="fade"
                  data-aos-delay="0"
                  data-aos-duration="0"
                  data-aos-anchor="{{ animation_anchor }}"
                {% endif %}
              >
                {%- unless equalize_height -%}
                  {%- style -%}
                    #columnItemImage--{{ item_id }} { --aspect-ratio: {{ item_aspect_ratio }}%; }
                  {%- endstyle -%}
                {%- endunless -%}

                <div class="column-item__inner">
                  {%- if show_images -%}
                    <div
                      id="columnItemImage--{{ item_id }}"
                      class="column-item__image-wrapper"
                      data-media-container
                      {% if animations_enabled %}
                        data-aos="fade-up"
                        data-aos-anchor="{{ animation_anchor }}"
                        data-aos-delay="{{ animation_delay }}"
                        {%- assign animation_delay = animation_delay | plus: 150 -%}
                      {% endif %}
                    >
                      {%- render 'image-fill',
                        is_background: true,
                        img_object: image,
                        sizes: sizes,
                        classes: 'column-item__image',
                        alt: image_alt
                      -%}
                    </div>
                  {%- endif -%}

                  <div
                    class="column-item__content"
                    {% if animations_enabled %}
                      data-aos="fade-up"
                      data-aos-anchor="{{ animation_anchor }}"
                      data-aos-delay="{{ animation_delay }}"
                    {% endif %}
                  >
                    {%- if title != blank -%}
                      <h3 class="column-item__heading h6">{{ title | escape }}</h3>
                    {%- endif -%}

                    {%- if text != blank -%}
                      <div class="column-item__text">{{ text }}</div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <p>No ingredient metafields found for this product ({{ namespace }}.pdp_ingredient_name_1 … {{ max_items }}). This section is hidden on the live store.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ingredient notes",
  "class": "index-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Items are read from product metafields: pdp_note_image_N, pdp_ingredient_name_N and pdp_ingredient_description_N."
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum ingredients",
      "default": 5,
      "min": 1,
      "max": 10,
      "step": 1
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Only used when the section is placed outside a product page"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ingredient notes:"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "default": 120,
      "min": 70,
      "max": 200,
      "step": 10,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "item_heading_size",
      "label": "Ingredient name size",
      "default": 120,
      "min": 70,
      "max": 200,
      "step": 10,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "item_text_size",
      "label": "Ingredient description size",
      "default": 100,
      "min": 70,
      "max": 150,
      "step": 10,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "align_text",
      "label": "Text alignment",
      "default": "text-left",
      "options": [
        {"value": "text-left", "label": "Left"},
        {"value": "text-center", "label": "Centered"}
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns per slide on desktop",
      "default": 3,
      "min": 2,
      "max": 4,
      "step": 1
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns per slide on mobile",
      "default": "1",
      "options": [
        {"label": "1", "value": "1"},
        {"label": "2", "value": "2"}
      ]
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show images",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Show borders",
      "default": false
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "checkbox",
      "id": "equalize_height",
      "label": "Equalize image heights",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_aspect_ratio",
      "min": 0.5,
      "max": 1.5,
      "step": 0.1,
      "unit": ":1",
      "label": "Desktop height",
      "info": "Wide to tall",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "mobile_aspect_ratio",
      "min": 0.5,
      "max": 1.5,
      "step": 0.1,
      "unit": ":1",
      "label": "Mobile height",
      "info": "Wide to tall",
      "default": 0.9
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "gradient",
      "label": "Overlay gradient"
    },
    {
      "type": "color",
      "id": "color_borders",
      "label": "Borders",
      "default": "#000"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Layout",
      "default": "carousel",
      "options": [
        {"value": "grid", "label": "Grid"},
        {"value": "stacked", "label": "Stacked"},
        {"value": "carousel", "label": "Slider"}
      ]
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper",
      "options": [
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Page width"}
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Ingredient notes"
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside"]
  }
}
{% endschema %}
