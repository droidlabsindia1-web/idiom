{%- comment -%} /sections/idiom-newsletter.liquid — footer newsletter strip (heading left, pill email field right) {%- endcomment -%}
{{ 'idiom-newsletter.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign form_id = 'IdiomNewsletter--' | append: section.id
  assign placeholder = section.settings.placeholder | default: 'email'
  assign bg_image = section.settings.bg_image
  assign bg_image_mobile = section.settings.bg_image_mobile | default: bg_image

  assign heading_color = section.settings.heading_color
  if heading_color == blank or heading_color.alpha == 0.0
    assign heading_color = section.settings.text_color
  endif

  comment
    Theme ships only Farro Regular + Bold (each declared at weight 400 under its own family name).
    Light (300) and Medium (500) come from Google Fonts' Farro, loaded only when chosen.
    100/200 -> Light 300 (lightest Farro cut); 600-900 -> Bold file.
  endcomment
  assign heading_weight = section.settings.heading_weight | default: '400' | plus: 0
  assign google_weight = blank
  case heading_weight
    when 100, 200, 300
      assign google_weight = '300'
      assign heading_font = '"Farro", var(--FONT-STACK-BODY)'
      assign heading_font_weight = 300
    when 500
      assign google_weight = '500'
      assign heading_font = '"Farro", var(--FONT-STACK-BODY)'
      assign heading_font_weight = 500
    when 600, 700, 800, 900
      assign heading_font = 'var(--FONT-STACK-HEADING)'
      assign heading_font_weight = 400
    else
      assign heading_font = 'var(--FONT-STACK-BODY)'
      assign heading_font_weight = 400
  endcase
-%}

{%- if google_weight != blank -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Farro:wght@{{ google_weight }}&display=swap">
{%- endif -%}

{%- style -%}
  #IdiomNewsletter--{{ section.id }} {
    --idiom-nl-bg: {{ section.settings.bg_color }};
    --idiom-nl-text: {{ section.settings.text_color }};
    --idiom-nl-pt: {{ section.settings.padding_top }}px;
    --idiom-nl-pb: {{ section.settings.padding_bottom }}px;
    --idiom-nl-max: {{ section.settings.content_max_width }}px;
    --idiom-nl-heading-max: {{ section.settings.heading_max_width }}px;
    --idiom-nl-heading-size: {{ section.settings.heading_size }}px;
    --idiom-nl-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --idiom-nl-heading-font: {{ heading_font }};
    --idiom-nl-heading-weight: {{ heading_font_weight }};
    --idiom-nl-heading-color: {{ heading_color }};
    --idiom-nl-overlay: {{ section.settings.overlay_color }};
    --idiom-nl-overlay-opacity: {{ section.settings.overlay_opacity | times: 0.01 }};
    --idiom-nl-bg-position: {{ section.settings.bg_position }};
    --idiom-nl-field-bg: {{ section.settings.field_bg_color | default: '#fffbf3' }};
    --idiom-nl-field-border: {{ section.settings.field_border_color | default: '#1a1a1a' }};
    --idiom-nl-field-text: {{ section.settings.field_text_color | default: '#1a1a1a' }};
  }
{%- endstyle -%}

<section
  class="idiom-newsletter{% if bg_image %} idiom-newsletter--has-image{% endif %}"
  id="IdiomNewsletter--{{ section.id }}"
>
  {%- if bg_image -%}
    <div class="idiom-newsletter__media" aria-hidden="true">
      {{
        bg_image
        | image_url: width: 3000
        | image_tag:
          widths: '768, 1100, 1500, 2000, 2600, 3000',
          sizes: '100vw',
          loading: 'lazy',
          alt: '',
          class: 'idiom-newsletter__bg idiom-newsletter__bg--desktop'
      }}
      {{
        bg_image_mobile
        | image_url: width: 1200
        | image_tag:
          widths: '480, 768, 1200',
          sizes: '100vw',
          loading: 'lazy',
          alt: '',
          class: 'idiom-newsletter__bg idiom-newsletter__bg--mobile'
      }}
      <div class="idiom-newsletter__overlay"></div>
    </div>
  {%- endif -%}

  <div class="idiom-newsletter__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="idiom-newsletter__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- endif -%}

    <div class="idiom-newsletter__form-wrap">
      {%- form 'customer', id: form_id, class: 'idiom-newsletter__form' -%}
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          <p class="idiom-newsletter__message idiom-newsletter__message--success" role="status">
            {{ section.settings.success_text | default: 'Thank you for signing up!' }}
          </p>
        {%- else -%}
          <div class="idiom-newsletter__pill">
            <label for="IdiomNewsletterEmail--{{ section.id }}" class="visually-hidden">{{ placeholder }}</label>
            <input
              type="email"
              id="IdiomNewsletterEmail--{{ section.id }}"
              class="idiom-newsletter__input"
              name="contact[email]"
              placeholder="{{ placeholder | escape }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
              {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="IdiomNewsletterError--{{ section.id }}"{% endif %}
            >
            <button type="submit" class="idiom-newsletter__submit" aria-label="{{ section.settings.button_label | default: 'Subscribe' | escape }}">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
                <path d="M2 9h13M10 4l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

          {%- if form.errors -%}
            <p class="idiom-newsletter__message idiom-newsletter__message--error" id="IdiomNewsletterError--{{ section.id }}" role="alert">
              {{ 'general.newsletter_form.newsletter_error' | t }}
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.disclaimer != blank -%}
        <div class="idiom-newsletter__disclaimer">{{ section.settings.disclaimer }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "idiom newsletter",
  "class": "idiom-newsletter-section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to receive a complimentary gift with your first order"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label (screen readers)",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thank you for signing up! Your gift is on its way to your inbox."
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Small print",
      "info": "Optional text under the email field"
    },
    {
      "type": "paragraph",
      "content": "Subscribers appear under 'Email subscribed' in your [customer admin](/admin/customers), tagged 'newsletter'."
    },
    {
      "type": "header",
      "content": "Heading style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size (desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 30
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Font weight",
      "info": "Farro comes in Light (300), Regular (400), Medium (500) and Bold (700). 100–200 show as Light, 600–900 as Bold.",
      "default": "400",
      "options": [
        { "value": "100", "label": "100 – Thin" },
        { "value": "200", "label": "200 – Extra light" },
        { "value": "300", "label": "300 – Light" },
        { "value": "400", "label": "400 – Regular" },
        { "value": "500", "label": "500 – Medium" },
        { "value": "600", "label": "600 – Semi bold" },
        { "value": "700", "label": "700 – Bold" },
        { "value": "800", "label": "800 – Extra bold" },
        { "value": "900", "label": "900 – Black" }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Font colour",
      "info": "Leave empty to use the text colour below"
    },
    {
      "type": "header",
      "content": "Width"
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Heading max width",
      "default": 520
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "info": "Width of the heading + email row",
      "default": 1280
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#fffbf3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and border",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Email field"
    },
    {
      "type": "color",
      "id": "field_bg_color",
      "label": "Field background",
      "default": "#fffbf3"
    },
    {
      "type": "color",
      "id": "field_border_color",
      "label": "Field border",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "field_text_color",
      "label": "Field text and arrow",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Mobile image",
      "info": "Optional. Uses the main image if empty"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image position",
      "default": "center center",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "info": "Darkens the image so text stays readable",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "idiom newsletter"
    }
  ],
  "enabled_on": {
    "groups": ["footer"],
    "templates": ["*"]
  }
}
{% endschema %}
