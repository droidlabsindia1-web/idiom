{{ 'idiom-reel-video-section.css' | asset_url | stylesheet_tag }}

<section
  class="idiom-reel-section"
  style="
    {%- if section.settings.bg_image_desktop != blank -%}
      --reel-bg-desktop: url('{{ section.settings.bg_image_desktop | image_url: width: 2000 }}');
    {%- endif -%}
    {%- if section.settings.bg_image_mobile != blank -%}
      --reel-bg-mobile: url('{{ section.settings.bg_image_mobile | image_url: width: 800 }}');
    {%- endif -%}
  ">
  {%- comment -%}
    SKU-specific copy: product.metafields.custom.video_section_heading and
    custom.video_section_text (single/multi-line text). Falls back to section settings.
  {%- endcomment -%}
  {%- assign reel_title = product.metafields.custom.video_section_heading.value | default: section.settings.section_title -%}
  {%- assign reel_subtitle = product.metafields.custom.video_section_text.value | default: section.settings.section_subtitle -%}
  <h2 class="idiom-reel-section__title">{{ reel_title }}</h2>
  {% if reel_subtitle != blank %}
    <p class="idiom-reel-section__subtitle">{{ reel_subtitle | newline_to_br }}</p>
  {% endif %}

  <div class="idiom-reel-slider-wrapper">
    <div class="idiom-reel-slider">
      {%- comment -%}
        SKU-specific videos: product.metafields.custom.social_proof_videos
        (list of video files or URLs). Falls back to the section's video blocks.
      {%- endcomment -%}
      {%- assign reel_videos = product.metafields.custom.social_proof_videos.value -%}
      {%- if reel_videos != blank -%}
        {%- for reel_video in reel_videos -%}
          {%- assign reel_src = reel_video -%}
          {%- if reel_video.sources -%}
            {%- assign reel_src = reel_video.sources.last.url -%}
          {%- endif -%}
          <div
            class="idiom-reel-card"
            data-video-src="{{ reel_src }}"
            data-buy-now-text="{{ section.settings.metafield_cta_text }}"
            data-buy-now-url="{{ product.url }}">
            <video
              data-src="{{ reel_src }}"
              loop
              muted
              playsinline
              preload="none"></video>
          </div>
        {%- endfor -%}
      {%- else -%}
        {% for block in section.blocks %}
          <div
            class="idiom-reel-card"
            data-video-src="{{ block.settings.video_url }}"
            data-buy-now-text="{{ block.settings.buy_now_text }}"
            data-buy-now-url="{{ block.settings.buy_now_url }}"
            {{ block.shopify_attributes }}>
            <video
              data-src="{{ block.settings.video_url }}"
              loop
              muted
              playsinline
              preload="none"></video>
          </div>
        {% endfor %}
      {%- endif -%}
    </div>
  </div>
</section>

<!-- Fullscreen reel modal -->
<div id="idiomReelModal" class="idiom-reel-modal" aria-hidden="true">
  <button class="idiom-reel-close-btn" aria-label="Close" onclick="idiomCloseReel()">&#x2715;</button>
  <div class="idiom-reel-modal__wrapper" id="idiomReelWrapper"></div>
</div>

<script src="{{ 'idiom-reel-video-section.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Video Reel Carousel",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "See it in action"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle"
    },
    {
      "type": "image_picker",
      "id": "bg_image_desktop",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "paragraph",
      "content": "On product pages, product metafields custom.video_section_heading and custom.video_section_text replace the title/subtitle above, and custom.social_proof_videos replaces the video blocks below."
    },
    {
      "type": "text",
      "id": "metafield_cta_text",
      "label": "CTA text for metafield videos",
      "default": "Shop Now"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL"
        },
        {
          "type": "text",
          "id": "buy_now_text",
          "label": "CTA Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "buy_now_url",
          "label": "CTA Button URL"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Video Reel Carousel",
      "category": "Video"
    }
  ]
}
{% endschema %}
