{%- comment -%}
  idiom — Store map with red pin + store-details modal.
  Used by sections/idiom-store-locator.liquid and snippets/locations.liquid.

  Map modes:
  - api_key + lat/lng → interactive Google Maps JS map with custom red marker.
  - otherwise → keyless Google Maps embed (static preview) with a red pin button on top.

  Accepts:
  - id: {String} unique id (e.g. section.id or block.id) — required
  - name: {String} store name (modal title)
  - address: {String}
  - hours: {String} richtext HTML
  - phone, email: {String}
  - note: {String} richtext HTML
  - image: {Object} image for the modal (optional)
  - lat, lng: {String} coordinates (optional, address used if blank)
  - zoom: {Number} default 16
  - map_style: {String} 'muted' | 'standard'
  - api_key: {String} Google Maps JS API key (optional)
  - directions_label: {String} leave blank to hide
{%- endcomment -%}

{%- liquid
  assign lat = lat | strip
  assign lng = lng | strip
  assign api_key = api_key | strip
  assign zoom = zoom | default: 16

  if lat != blank and lng != blank
    assign map_query = lat | append: ',' | append: lng
  else
    assign map_query = address | url_encode
  endif

  assign directions_url = 'https://www.google.com/maps/dir/?api=1&destination=' | append: map_query
-%}

{%- comment -%} Safe to include per render: the JS guards against double-definition {%- endcomment -%}
{{ 'idiom-store-locator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'idiom-store-locator.js' | asset_url }}" defer></script>

<idiom-store-map class="idiom-store-map">
  <div
    class="idiom-store-locator__map"
    data-map
    data-lat="{{ lat | escape }}"
    data-lng="{{ lng | escape }}"
    data-zoom="{{ zoom }}"
    data-style="{{ map_style }}"
    data-title="{{ name | escape }}"
    {% if api_key != blank %}data-api-key="{{ api_key | escape }}"{% endif %}
  >
    {%- if map_query != blank -%}
      <iframe
        data-map-fallback
        src="https://maps.google.com/maps?q={{ map_query }}&z={{ zoom }}&output=embed"
        title="{{ 'Map showing' | append: ' ' | append: name | escape }}"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        tabindex="-1"
      ></iframe>
      <button
        type="button"
        class="idiom-store-locator__pin"
        data-map-fallback
        data-open-store-modal
        aria-haspopup="dialog"
        aria-label="{{ 'View store details for' | append: ' ' | append: name | escape }}"
      >
        <svg viewBox="0 0 40 52" aria-hidden="true" focusable="false">
          <path d="M20 0C9 0 0 8.9 0 19.9 0 34.8 20 52 20 52s20-17.2 20-32.1C40 8.9 31 0 20 0z" fill="#E53935"/>
          <circle cx="20" cy="19" r="7" fill="#fff"/>
        </svg>
      </button>
    {%- else -%}
      <div class="idiom-store-locator__map-placeholder">
        Add the store address or latitude / longitude to show the map.
      </div>
    {%- endif -%}
  </div>

  <dialog class="idiom-store-modal" aria-labelledby="StoreModalTitle-{{ id }}">
    <button type="button" class="idiom-store-modal__close" data-modal-close aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>

    {%- if image != blank -%}
      {{
        image
        | image_url: width: 840
        | image_tag: class: 'idiom-store-modal__image', loading: 'lazy', alt: name
      }}
    {%- endif -%}

    <div class="idiom-store-modal__body">
      <h3 class="idiom-store-modal__title" id="StoreModalTitle-{{ id }}">{{ name }}</h3>

      <ul class="idiom-store-modal__list">
        {%- if address != blank -%}
          <li class="idiom-store-modal__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <path d="M12 21s-7-6.2-7-11.5a7 7 0 1114 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
            </svg>
            <span>{{ address }}</span>
          </li>
        {%- endif -%}

        {%- if hours != blank -%}
          <li class="idiom-store-modal__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
            </svg>
            <div>{{ hours }}</div>
          </li>
        {%- endif -%}

        {%- if phone != blank -%}
          <li class="idiom-store-modal__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/>
            </svg>
            <a href="tel:{{ phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ phone }}</a>
          </li>
        {%- endif -%}

        {%- if email != blank -%}
          <li class="idiom-store-modal__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
            </svg>
            <a href="mailto:{{ email }}">{{ email }}</a>
          </li>
        {%- endif -%}

        {%- if note != blank -%}
          <li class="idiom-store-modal__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
            </svg>
            <div>{{ note }}</div>
          </li>
        {%- endif -%}
      </ul>

      {%- if directions_label != blank and map_query != blank -%}
        <a class="idiom-store-modal__cta" href="{{ directions_url }}" target="_blank" rel="noopener">
          {{ directions_label }}
        </a>
      {%- endif -%}
    </div>
  </dialog>
</idiom-store-map>
