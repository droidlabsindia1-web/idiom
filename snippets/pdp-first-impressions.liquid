<!-- /snippets/pdp-first-impressions.liquid -->
{%- comment -%}
  Renders the "FIRST IMPRESSIONS" video-thumbnail row on the PDP.

  Each thumbnail is a circular, always-playing (muted, looping) video.
  Clicking a thumbnail opens a fullscreen vertical reel modal — the same
  design as the "Video Reel Carousel" section (idiom-reel-video-section).

  Accepts:
  - product: {Object} Current product (required)

  Video sources: product.metafields.custom.first_impression_videos
  (a list of video files, or comma-separated URL text). Nothing renders when empty.

  Usage:
  {%- render 'pdp-first-impressions', product: product -%}
{%- endcomment -%}

{{ 'idiom-first-impressions.css' | asset_url | stylesheet_tag }}

{%- assign fi_metafield = product.metafields.custom.first_impression_videos.value -%}
{%- assign fi_buy_url = product.url -%}
{%- assign fi_buy_text = 'Shop Now' -%}

{%- if fi_metafield.first != nil -%}
  {%- assign fi_videos = fi_metafield -%}
{%- elsif fi_metafield != blank and fi_metafield.sources == nil -%}
  {%- assign fi_videos = fi_metafield | split: ',' -%}
{%- endif -%}

{%- capture fi_thumbs -%}
  {%- for fi_video in fi_videos -%}
    {%- assign fi_src = blank -%}
    {%- if fi_video.sources -%}
      {%- for fi_source in fi_video.sources -%}
        {%- if fi_source.format == 'mp4' and fi_src == blank -%}
          {%- assign fi_src = fi_source.url -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if fi_src == blank -%}{%- assign fi_src = fi_video.sources.first.url -%}{%- endif -%}
    {%- elsif fi_video.external_id == nil -%}
      {%- assign fi_src = fi_video | strip -%}
    {%- endif -%}
    {%- if fi_src != blank -%}
      <button
        type="button"
        class="idiom-fi__thumb"
        data-video-src="{{ fi_src }}"
        data-buy-now-text="{{ fi_buy_text }}"
        data-buy-now-url="{{ fi_buy_url }}"
        aria-label="Play first impression video">
        <video
          data-src="{{ fi_src }}"
          loop
          muted
          playsinline
          preload="none"></video>
      </button>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if fi_thumbs contains 'idiom-fi__thumb' -%}
<div class="idiom-fi">
  <p class="idiom-fi__label">FIRST IMPRESSIONS:</p>
  <div class="idiom-fi__thumbs">
    {{ fi_thumbs }}
  </div>
</div>

<!-- Fullscreen first-impressions reel modal -->
<div id="idiomFiModal" class="idiom-fi-modal" aria-hidden="true">
  <button class="idiom-fi-close-btn" aria-label="Close" onclick="idiomCloseFi()">&#x2715;</button>
  <div class="idiom-fi-modal__wrapper" id="idiomFiWrapper"></div>
</div>

<script src="{{ 'idiom-first-impressions.js' | asset_url }}" defer></script>
{%- endif -%}
